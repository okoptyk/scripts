---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Lang from '@/components/Lang.astro';
import MetaBlock from '@/components/MetaBlock.astro';
import MetaItem from '@/components/MetaItem.astro';
import Tabs from '@/components/Tabs.astro';
import TabPanel from '@/components/TabPanel.astro';
import InfoBox from '@/components/InfoBox.astro';
import ScriptLang from '@/components/ScriptLang.astro';
import ScriptLangPanel from '@/components/ScriptLangPanel.astro';
import StagePath from '@/components/StagePath.astro';
import { t } from './_i18n';
import { tFree } from './_i18n-opto-free';
import { phoneFreeBody } from './_i18n-phone-free';

const slug = 'kvalifikaciya';
const LANGS = ['ru','ua','pl'] as const;
---
<BaseLayout slug={slug} copy=".tab-panel[data-tab='start'], .tab-panel[data-tab='opto'], .tab-panel[data-tab='oftal']">
  <div class="page-header">
    <div class="page-header-inner">
      {LANGS.map((l) => (
        <Lang lang={l}>
          <h1>{t.headerTitle[l]}</h1>
          <p>{t.headerSub[l]}</p>
        </Lang>
      ))}
    </div>
  </div>

  <div class="container">
    <MetaBlock>
      {LANGS.map((l) => (
        <Lang lang={l}>
          <MetaItem label={t.metaCkpLabel[l]} html={t.metaCkp[l]} />
          <MetaItem label={t.metaDeadlineLabel[l]} html={t.metaDeadline[l]} />
          <MetaItem label={t.metaResponsibleLabel[l]} html={t.metaResponsible[l]} />
          <MetaItem label={t.metaChannelsLabel[l]} html={t.metaChannels[l]} />
        </Lang>
      ))}
    </MetaBlock>

    <Tabs buttons={[{ id:'opto', label: t.tabOpto.ru }, { id:'oftal', label: t.tabOftal.ru }, { id:'start', label: t.tabStart.ru }, { id:'phone', label: t.tabPhone.ru }]}>
      <TabPanel id="phone">
        <Tabs buttons={[{ id:'phone-free', label: tFree.subFree.ru }, { id:'phone-99', label: tFree.sub99.ru }]}>
          <TabPanel id="phone-free" first>
            <ScriptLang>
              {LANGS.map((l) => (
                <ScriptLangPanel lang={l} idBase="phone-free">
                  <div set:html={phoneFreeBody[l]} />
                </ScriptLangPanel>
              ))}
            </ScriptLang>
          </TabPanel>
          <TabPanel id="phone-99">
            <ScriptLang>
              {LANGS.map((l) => (
                <ScriptLangPanel lang={l} idBase="phone">
                  <div set:html={t.phoneBody[l]} />
                </ScriptLangPanel>
              ))}
            </ScriptLang>
          </TabPanel>
        </Tabs>
      </TabPanel>

      <TabPanel id="start">
        {LANGS.map((l) => (
          <Lang lang={l}><InfoBox html={t.rules[l]} /></Lang>
        ))}
        <ScriptLang>
          {LANGS.map((l) => (
            <ScriptLangPanel lang={l} idBase="start">
              <div set:html={t.startBody[l]} />
            </ScriptLangPanel>
          ))}
        </ScriptLang>
      </TabPanel>

      <TabPanel id="opto" first>
        <Tabs buttons={[{ id:'opto-free', label: tFree.subFree.ru }, { id:'opto-99', label: tFree.sub99.ru }]}>
          <TabPanel id="opto-free" first>
            <ScriptLang>
              {LANGS.map((l) => (
                <ScriptLangPanel lang={l} idBase="opto-free">
                  <div set:html={tFree.optoFreeBody[l]} />
                </ScriptLangPanel>
              ))}
            </ScriptLang>
          </TabPanel>
          <TabPanel id="opto-99">
            <ScriptLang>
              {LANGS.map((l) => (
                <ScriptLangPanel lang={l} idBase="opto">
                  <div set:html={t.optoBody[l]} />
                </ScriptLangPanel>
              ))}
            </ScriptLang>
          </TabPanel>
        </Tabs>
      </TabPanel>

      <TabPanel id="oftal">
        <ScriptLang>
          {LANGS.map((l) => (
            <ScriptLangPanel lang={l} idBase="oftal">
              <div set:html={t.oftalBody[l]} />
            </ScriptLangPanel>
          ))}
        </ScriptLang>
      </TabPanel>
    </Tabs>

    {LANGS.map((l) => (
      <Lang lang={l}><StagePath current={slug} lang={l} nextLabel={t.nextBtn[l]} /></Lang>
    ))}
  </div>
</BaseLayout>
